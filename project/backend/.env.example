# 复制为 .env 后填写真实值（.env 已被 git 忽略）
# ===== LLM =====
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-chat

# ===== 数据 =====
# 相对路径基准：项目根目录（backend/），见 app/core/config.py
DB_PATH=data/water.db
AUDIT_PATH=data/audit.jsonl

# ===== CORS（前端开发服务器） =====
CORS_ORIGINS=http://localhost:5173

# ===== PostgreSQL（W8 起的空间数据库；后端仅用只读角色） =====
PG_HOST=localhost
PG_PORT=5432
PG_DB=ai_water_budget
PG_USER=ai_reader
PG_PASSWORD=your-ai-reader-password

# ===== PostgreSQL 测试库（Day 11；conftest 消费；ai_test_writer 仅测试库可写） =====
TEST_PG_DB=ai_water_budget_test
TEST_PG_USER=ai_test_writer
TEST_PG_PASSWORD=your-test-writer-password
